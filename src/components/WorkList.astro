---
import { getCollection, getEntry } from 'astro:content';
import WorkItem from '../components/WorkItem.astro';

const entry = await getCollection('workResearch');
const entry2 = await getCollection('workTeaching');
if (!entry) { console.error(entry); }
if (!entry2) { console.error(entry2); }
---
<section class="mt-sec">
  <h2 id="work">Research Experience</h2>
  <ul>
    {entry[0]?.data?.sections?.map((section) => (
      <li>
        <h3 id={section.id}>{section.title}</h3>
        {section.items.map((item) => (
          <WorkItem
            job={item.job}
            team={item.team}
            advisor={item.advisor}
            company={item.company}
            address={item.address}
            dateStart={item.dateStart}
            dateEnd={item.dateEnd}
            noprint={item.noprint}
          >
          {item.description && (
            <ul class="workdesc">
              {item.description.map((d) => (
                <li><p set:html={d}></p></li>
              ))}
            </ul>
          )}
          </WorkItem>
        ))}
      </li>
    ))}
  </ul>
</section>

<section class="mt-sec">
  <h2 id="teach-ta">Teaching Experience</h2>
  <ul>
    {entry2[0]?.data?.sections?.map((section) => (
      <li>
        {section.items.map((item) => (
          <WorkItem
            job={item.job}
            team={item.team}
            advisor={item.advisor}
            company={item.company}
            address={item.address}
            dateStart={item.dateStart}
            dateEnd={item.dateEnd}
            noprint={item.noprint}
          >
          {item.description && (
            <ul class="workdesc">
              {item.description.map((d) => (
                <li><p set:html={d}></p></li>
              ))}
            </ul>
          )}
          </WorkItem>
        ))}
      </li>
    ))}
  </ul>
</section>

<style>
  @reference "../styles/common.css";
  @layer base {
    ul.workdesc {
      @apply list-disc text-zinc-700 dark:text-zinc-400 print:text-zinc-700 text-sm mt-space ml-4;
    }
  }
</style>