---
import { getCollection, getEntry } from 'astro:content';
const entry = await getCollection('skills');
if (!entry) { console.error(entry); }
---
<section class="mt-sec">
  <h2 id="skills">Skills</h2>
  {entry[0].data?.sections.map((section) => (
    <div class="break-inside-avoid-page">
      <h3 id={section.id}>{section.title}</h3>
      <ul class={section.title === 'Languages' ? 'sm:grid grid-cols-3 print:grid-cols-4 gap-x-2' : ''}>
        {section.items.map((item) => (
          <li class={section.title !== 'Languages' ? 'print:grid grid-cols-4 gap-x-2' : item.title === 'English' ? 'print:col-span-2' : ''}>
            <p class="print:inline">{item.title}</p>
            <p class="acc1 print:inline print:col-start-2 print:col-end-5">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>

<style>
  @reference "../styles/common.css";
  @layer base {
    li {@apply mb-el;}
  }
</style>