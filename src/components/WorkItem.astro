---
import Date from '../components/Date.astro';
const { company, address, dateStart, dateEnd = "Present", job, team, advisor, noprint = false } = Astro.props;
---

<li class={ noprint ? "mb-el print:hidden" : "mb-el"}>
  <div class="break-inside-avoid-page">
    <div class="sm:flex sm:flex-row items-start justify-between">
      <p class="print:font-semibold">{job}</p>
      <Date
        dateStart={dateStart}
        dateEnd={dateEnd}
      />
    </div>
    <p class="acc1">{team}{advisor && ` (Advisor: ${advisor})`}</p>
    <p class="acc2">{company}, {address}</p>
  </div>
  <slot />
</li>

<style>
  @reference "../styles/common.css";
  @layer base {
    p.acc1, p.acc2 {@apply print:inline;}
    @media print {
      p.acc1::after {content: ",";}
    }
  }
</style>
